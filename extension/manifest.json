{
  "manifest_version": 3,
  "name": "CH Classroom Hub — KMUTNB Reg Auto-Sync",
  "version": "1.1.0",
  "description": "ซิงค์ตารางเรียน วันสอบ และผลการศึกษาจาก reg.kmutnb.ac.th เข้า CH Classroom Hub อัตโนมัติเมื่อเปิดหน้าเว็บ (ไม่เก็บรหัสผ่าน ICIT)",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "CH Classroom Hub — KMUTNB Reg Sync",
    "default_icon": {
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://reg.kmutnb.ac.th/registrar/*"
      ],
      "js": [
        "regContent.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://classrooms-hub.vercel.app/*",
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*",
        "http://localhost:4173/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
